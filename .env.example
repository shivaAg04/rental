# --- Local development ---
# A local SQLite file is used automatically when TURSO_DATABASE_URL /
# TURSO_AUTH_TOKEN are not set. No setup needed.
DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret  (or: openssl rand -base64 32)
# Use a different value in production than in dev.
AUTH_SECRET=""

# --- Production (Turso) ---
# Set these on your host (e.g. Vercel) to switch from local SQLite to a
# hosted Turso (libSQL) database. Leave unset for local dev.
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN=""

# --- Seeding ---
# Used only by `npm run db:seed`. Set these before seeding a production
# database so it doesn't ship with the dev admin password.
# ADMIN_EMAIL="admin@yourdomain.com"
# ADMIN_PASSWORD=""
